
<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- LEFT WALL -->
    <model name="left_wall">
      <static>true</static>
      <pose>-1.05 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 2.2 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 2.2 0.4</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- RIGHT WALL -->
    <model name="right_wall">
      <static>true</static>
      <pose>1.05 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 2.2 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 2.2 0.4</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- TOP WALL -->
    <model name="top_wall">
      <static>true</static>
      <pose>0 1.05 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.2 0.1 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.2 0.1 0.4</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- BOTTOM WALL -->
    <model name="bottom_wall">
      <static>true</static>
      <pose>0 -1.05 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.2 0.1 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.2 0.1 0.4</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>

